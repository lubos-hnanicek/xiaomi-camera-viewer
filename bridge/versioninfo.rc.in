#include <winver.h>

// Version metadata for xmbridge.dll. Generated by CMake from
// bridge/versioninfo.rc.in, compiled by windres, and picked up by the Go linker
// as a .syso because Go emits no version resource of its own.
//
// The strings and the version deliberately match the executable's, because the
// package is one product and should report one version throughout.
VS_VERSION_INFO VERSIONINFO
    FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@XV_PUBLISHER@"
            VALUE "FileDescription", "Xiaomi camera protocol bridge"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "xmbridge"
            VALUE "LegalCopyright", "@XV_COPYRIGHT@"
            VALUE "OriginalFilename", "xmbridge.dll"
            VALUE "ProductName", "@XV_PRODUCT_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
