{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "XV_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC 2026 x64 (Ninja Multi-Config)",
      "description": "Default preset. Uses the MSVC toolchain from a Developer Command Prompt or the Visual Studio CMake integration.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "XV_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "msvc-arm64",
      "displayName": "MSVC 2026 ARM64 (Ninja Multi-Config)",
      "description": "Cross-compiles ARM64 using the MSVC toolchain from an x64 Developer Command Prompt.",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/msvc-arm64",
      "architecture": {
        "value": "ARM64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "XV_ARCHITECTURE": "arm64"
      }
    },
    {
      "name": "vs2026",
      "displayName": "MSVC 2026 x64 (Visual Studio solution)",
      "description": "Generates a .sln for those who prefer the classic solution workflow.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": "x64"
    },
    {
      "name": "vs2026-arm64",
      "displayName": "MSVC 2026 ARM64 (Visual Studio solution)",
      "description": "Generates an ARM64 .sln for those who prefer the classic solution workflow.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/vs2026-arm64",
      "architecture": "ARM64",
      "cacheVariables": {
        "XV_ARCHITECTURE": "arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "arm64-debug",
      "displayName": "ARM64 Debug",
      "configurePreset": "msvc-arm64",
      "configuration": "Debug"
    },
    {
      "name": "arm64-release",
      "displayName": "ARM64 Release",
      "configurePreset": "msvc-arm64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vs-release",
      "displayName": "Release (Visual Studio)",
      "configurePreset": "vs2026",
      "configuration": "RelWithDebInfo"
    }
  ]
}
