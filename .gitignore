# Build output
/build/
/dist/
/out/

# Fetched dependencies. scripts/fetch-deps.ps1 recreates these, and the FFmpeg
# binaries in particular are far too large to keep in the repository.
/third_party/imgui/
/third_party/ffmpeg/
/third_party/nlohmann/
/third_party/go2rtc/

# Local verification tooling
/tools/

# Generated by the Go c-shared build alongside the DLL
/bridge/xmbridge.h

# Visual Studio and editors
.vs/
.vscode/
*.user
CMakeUserPresets.json
CMakeSettings.json

# Build artefacts that can escape the build directory
*.obj
*.pdb
*.ilk
*.exp
*.log
